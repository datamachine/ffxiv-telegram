<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.1.6</Version>
    <Name>FFXIV Telegram</Name>
    <InternalName>FFXIVTelegram</InternalName>
    <AssemblyVersion>0.1.6.0</AssemblyVersion>
    <Punchline>Bridge FFXIV chat to Telegram</Punchline>
    <Description>Bridge selected Final Fantasy XIV chat channels to a private Telegram bot so you can read and reply to tells, party, and FC messages from your phone.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <Tags>chat;telegram;messaging</Tags>
    <Author>Surye</Author>
    <DalamudApiLevel>15</DalamudApiLevel>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FFXIVTelegram.Tests" />
  </ItemGroup>
</Project>
